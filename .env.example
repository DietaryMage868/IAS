# ============================================================================
# Instant AI Storefront (IAS) — Environment Configuration
# PayPal AI Hackathon Edition
# ============================================================================

# --- Application Settings ---
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./ias_storefront.db
DEFAULT_SHOP_ID=123
PREVIEW_TOKEN_TTL_MINUTES=15
RESERVATION_TTL_MINUTES=15
DEFAULT_UAH_TO_USD_RATE=40.0

# --- Google Gemini Multimodal AI (Voice + Photo + Text) ---
# Leave empty to use the built-in Smart Deterministic AI Fallback (100% offline/judge demo ready)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- PayPal Developer Sandbox & Partner Referrals ---
# Get credentials at https://developer.paypal.com/dashboard/applications/sandbox
# Leave empty to enable Interactive PayPal Sandbox Simulation Mode out-of-the-box
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=IAS_PLATFORM_PARTNER_ID

# --- Telegram Bot (@BotFather) ---
# Optional: Provide a token to run the real Telegram Bot alongside the Web Telegram Studio
TELEGRAM_BOT_TOKEN=
